# ---------------------------------------------------------------------------
# .env.example  ->  COMMITTED to git. Placeholders only. Safe to share.
# .env          ->  NEVER committed. Holds your real secrets.
#
# Setup:  cp .env.example .env    (then paste in your real values)
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Week 1 Neon string, WITH ?sslmode=require on the end.
# For migrations use the DIRECT host (no "-pooler" in the name).
DATABASE_URL="postgresql://user:password@your-project-name.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to SIGN and VERIFY JWTs. Any long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# How long a login stays valid. 1d = one day. Use 1h, 7d, etc.
JWT_EXPIRES_IN="1d"

# Port the API listens on.
PORT=3000
