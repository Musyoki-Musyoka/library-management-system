{
  "info": {
    "name": "Library Management System \u2014 Week 2 API",
    "description": "Full CRUD for Books and Genres, JWT auth, and role-based authorization.\n\n## How to use\n1. `cp .env.example .env`, set DATABASE_URL and JWT_SECRET\n2. `npm install && npm run db:migrate && npm run db:seed`\n3. `npm run start:dev`\n4. In Postman, run **Auth \u2192 Login (librarian)** and paste `access_token` into the `librarianToken` collection variable.\n\nSeeded accounts:\n- LIBRARIAN: grace.mwangi@example.com / librarian123\n- PATRON: amina.odhiambo@example.com / patron123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "librarianToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "Get all books (paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Returns { data, meta } with total/page/limit/totalPages."
          }
        },
        {
          "name": "Filter books by genre",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books?genreId=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "genreId",
                  "value": "2"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Search books by title/author",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books?search=cosmos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "cosmos"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Search + filter + paginate",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books?genreId=1&search=the&page=1&limit=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "genreId",
                  "value": "1"
                },
                {
                  "key": "search",
                  "value": "the"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get one book",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "1"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Books (protected)",
      "item": [
        {
          "name": "Create book (LIBRARIAN only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Cathedral and the Bazaar\",\n  \"author\": \"Eric S. Raymond\",\n  \"isbn\": \"9780596001087\",\n  \"totalCopies\": 2,\n  \"publishedYear\": 1999,\n  \"genreId\": 4\n}"
            }
          }
        },
        {
          "name": "Update book (LIBRARIAN only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "1"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Things Fall Apart (2nd ed.)\",\n  \"totalCopies\": 8\n}"
            }
          }
        },
        {
          "name": "Delete book (LIBRARIAN only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/17",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "17"
              ]
            },
            "description": ""
          }
        }
      ]
